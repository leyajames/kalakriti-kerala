# ============================================================================
# KALAKRITI - Environment Variables Template
# Note: Vite only exposes environment variables prefixed with VITE_ to the browser.
# SECURITY NOTICE: NEVER expose service_role secret keys or DB passwords here!
# ============================================================================

# Supabase Project URL (Public)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# Supabase Public Anon Key (Safe for browser / Client-side RLS)
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key-here"

# Application Base URL
VITE_APP_URL="http://localhost:3000"
